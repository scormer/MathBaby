# Copy to demo/.env and fill in. Without JEV_API_URL the demo uses the keyword mock scorer.
JEV_API_URL=
JEV_API_KEY=
# Header used to send the key; value is JEV_AUTH_PREFIX + JEV_API_KEY
JEV_AUTH_HEADER=Authorization
JEV_AUTH_PREFIX=Bearer 
# Optional extra top-level fields merged into the request body, as JSON, e.g. {"model":"jev-1"}
JEV_EXTRA_BODY=
# live | mock (defaults to live when JEV_API_URL is set)
JEV_MODE=
JEV_TIMEOUT_MS=90000
PORT=3000
